# Copy to .env (git-ignored) and fill in. Nothing in this file is a secret by itself,
# but key files and refresh tokens are: keep them out of the repository.

# --- Google Ads API (read by the google-ads client library) ---
# Developer tokens were sunset on 2026-09-09; API access now comes from the Google Cloud
# project that owns the OAuth client or service account. No developer token is needed, and
# Google says a future major API version will reject one: leave GOOGLE_ADS_DEVELOPER_TOKEN unset.
GOOGLE_ADS_USE_PROTO_PLUS=true
# Only when the accounts are reached through a manager (MCC) account:
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Option A: a service account added as a user in Google Ads (Admin > Access and security),
# with its JSON key kept outside the repository.
GOOGLE_ADS_JSON_KEY_FILE_PATH=

# Option B: OAuth for a Google user who can see the accounts.
# GOOGLE_ADS_CLIENT_ID=
# GOOGLE_ADS_CLIENT_SECRET=
# GOOGLE_ADS_REFRESH_TOKEN=

# Option C: Application Default Credentials that carry the adwords scope.
# GOOGLE_ADS_USE_APPLICATION_DEFAULT_CREDENTIALS=true

# --- Pipeline ---
GADS_CUSTOMER_IDS=123-456-7890
WAREHOUSE=bigquery
BQ_PROJECT=
BQ_LOCATION=EU
BQ_RAW_DATASET=google_ads_raw

# --- dbt (transform/profiles.yml) ---
DBT_TARGET=prod
BQ_DATASET=google_ads
